<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="auto_commission_config_company_rule" model="ir.rule">
        <field name="name">Auto Commission Config Multi Company</field>
        <field name="model_id" ref="account_auto_commission_extension.model_auto_commission_config"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field
            name="groups"
            eval="[
                (4, ref('account.group_account_manager')),
                (4, ref('account.group_account_user')),
                (4, ref('account.group_account_invoice')),
                (4, ref('sales_team.group_sale_salesman'))
            ]"
        />
    </record>
</odoo>
