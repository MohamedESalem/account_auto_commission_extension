<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_auto_commission_res_config_settings" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.account.auto.commission</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']" position="inside">
                <block title="Automatic Commission Assignment"
                       name="account_auto_commission_block"
                       groups="account.group_account_manager">
                    <setting id="account_auto_commission_agents"
                             string="Automatic Commission Agents"
                             help="Automatically add these commission agents on draft quotation/invoice lines when product settings also match.">
                        <field name="auto_commission_agent_ids"
                               widget="many2many_tags"
                               options="{'no_create_edit': True, 'no_open': True}"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
